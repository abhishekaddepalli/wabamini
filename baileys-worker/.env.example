# ==========================================
# WabaMini / Baileys WhatsApp Microservice Worker
# ==========================================

# Network binding (Localhost only for security)
HOST=127.0.0.1
PORT=3101

# Laravel Backend API communication (Webhook dispatch)
LARAVEL_API_URL=https://yourdomain.com

# Shared secret token matching BAILEYS_SECRET_TOKEN in backend/.env
BAILEYS_SECRET_TOKEN=generate_a_random_32_char_secret_here
INTERNAL_API_SECRET=generate_a_random_32_char_secret_here
