# ==========================================
# WabaMini / WhatsOmni Backend Environment Template
# ==========================================

APP_NAME=WabaMini
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL 8.0 on Ubuntu 24.04 localhost)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsomni
DB_USERNAME=wabamini_user
DB_PASSWORD=your_secure_db_password_here

# Session Configuration (Redis recommended for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting, Filesystem & Queues
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=wabamini_cache

# Redis Configuration (Localhost 6379)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (Realtime WebSocket Server - Systemd service on localhost:8080)
REVERB_APP_ID=wabamini_app_id
REVERB_APP_KEY=wabamini_reverb_key
REVERB_APP_SECRET=wabamini_app_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# Client-facing WebSocket configuration (Proxied via Nginx over port 443)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="yourdomain.com"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Meilisearch Scout Search (Optional, if meilisearch is installed)
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey123

# Google Sheets & Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/integrations/google/callback

# HubSpot CRM Integration (Optional)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Salesforce CRM Integration (Optional)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Zoho CRM Integration (Optional)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Meta / Facebook OAuth Integration (Optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Zoom Integration (Optional)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://yourdomain.com/api/integrations/zoom/callback

# Microsoft Teams Integration (Optional)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_REDIRECT_URI=https://yourdomain.com/api/integrations/teams/callback

# Mail & Resend Configuration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
RESEND_API_KEY=

# AI Provider API Keys (Optional defaults / managed via SuperAdmin DB)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AWS S3 Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Baileys WhatsApp Microservice Worker (Internal Systemd service on localhost:3101)
BAILEYS_WORKER_URL=http://127.0.0.1:3101
BAILEYS_SECRET_TOKEN=generate_a_random_32_char_secret_here
INTERNAL_API_SECRET=generate_a_random_32_char_secret_here
