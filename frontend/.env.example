# WhatsOmni Frontend Environment Configuration Example

# Backend API URL (Proxied via Next.js rewrites)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Laravel Reverb WebSocket Client Configuration
NEXT_PUBLIC_REVERB_APP_KEY=whatsomni_reverb_key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Production Deployment (Change for live domains):
# NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
# NEXT_PUBLIC_REVERB_APP_KEY=your_production_key
# NEXT_PUBLIC_REVERB_HOST=api.yourdomain.com
# NEXT_PUBLIC_REVERB_PORT=443
# NEXT_PUBLIC_REVERB_SCHEME=https
