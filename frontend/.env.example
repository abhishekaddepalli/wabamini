# ==========================================
# WabaMini Frontend Environment Configuration
# ==========================================

# Production Node server binding (Internal localhost only)
PORT=3100
HOST=127.0.0.1
NODE_ENV=production

# Backend API URL (Single domain: https://yourdomain.com | Split domain: https://api.yourdomain.com)
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com

# Laravel Reverb WebSocket Client Configuration
NEXT_PUBLIC_REVERB_APP_KEY=wabamini_reverb_key
NEXT_PUBLIC_REVERB_HOST=yourdomain.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
