# ==========================================
# WabaMini / WhatsOmni - Global Environment Template
# ==========================================

# 1. Project Domain Setup
DOMAIN=yourdomain.com
APP_URL=https://app.yourdomain.com
API_URL=https://api.yourdomain.com

# 2. MySQL Database Credentials
DB_ROOT_PASSWORD=secure_root_password_here
DB_DATABASE=whatsomni
DB_USERNAME=whatsomni
DB_PASSWORD=secure_whatsomni_password_here

# 3. Redis Credentials
REDIS_PASSWORD=secure_redis_password_here

# 4. Laravel Application Key
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE

# 5. Laravel Reverb WebSocket Credentials
REVERB_APP_ID=wabamini_app_id
REVERB_APP_KEY=wabamini_reverb_key
REVERB_APP_SECRET=wabamini_app_secret
REVERB_HOST=api.yourdomain.com
REVERB_PORT=443
REVERB_SCHEME=https

# 6. WhatsApp Worker Secret
INTERNAL_API_SECRET=generate_a_random_32_char_secret_here
