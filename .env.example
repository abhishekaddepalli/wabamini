# ==============================================================================
# WabaMini / WhatsOmni - Global Environment Template (Ubuntu 24.04 VPS Native)
# Standard Directory: /www/apps/wabamini
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Domains
# ------------------------------------------------------------------------------
# Single-Domain Architecture (Recommended):
DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
API_URL=https://yourdomain.com

# Split-Domain Architecture (Alternative):
# APP_URL=https://app.yourdomain.com
# API_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 2. MySQL Database Credentials (Listening strictly on 127.0.0.1:3306)
# ------------------------------------------------------------------------------
DB_DATABASE=whatsomni
DB_USERNAME=wabamini_user
DB_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 3. Redis Credentials (Listening strictly on 127.0.0.1:6379)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ------------------------------------------------------------------------------
# 4. Laravel Application Key (Generate via: php artisan key:generate)
# ------------------------------------------------------------------------------
APP_KEY=

# ------------------------------------------------------------------------------
# 5. Laravel Reverb Realtime WebSockets
# Internal binding: 127.0.0.1:8080 | Public entry: https://yourdomain.com:443/app
# ------------------------------------------------------------------------------
REVERB_APP_ID=wabamini_app_id
REVERB_APP_KEY=wabamini_reverb_key
REVERB_APP_SECRET=wabamini_reverb_secret
REVERB_HOST=yourdomain.com
REVERB_PORT=443
REVERB_SCHEME=https

# ------------------------------------------------------------------------------
# 6. Baileys WhatsApp Worker Secret & Port
# Internal binding: 127.0.0.1:3101 (Never exposed to public internet)
# ------------------------------------------------------------------------------
BAILEYS_PORT=3101
BAILEYS_SECRET_TOKEN=generate_a_random_32_char_secret_here
INTERNAL_API_SECRET=generate_a_random_32_char_secret_here

# ------------------------------------------------------------------------------
# 7. Next.js Frontend Server
# Internal binding: 127.0.0.1:3100 (Never exposed to public internet)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3100
